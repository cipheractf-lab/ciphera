# Copy this file to .env and fill in real values.
# Never commit .env -- it's gitignored, keep it that way.

NODE_ENV=development
PORT=10000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ciphera
MONGO_MAX_POOL_SIZE=150
MONGO_MIN_POOL_SIZE=15
# Only for local dev without a real MongoDB instance (never in production)
ENABLE_MEMORY_MONGO=false

# Redis Configuration
# Set DISABLE_REDIS=true to run without Redis (caching/rate limiting degrade gracefully)
DISABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_USER_CACHE_TTL=30m

# JWT Configuration -- generate a long random string for each secret,
# e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRE=24h
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_THRESHOLD_PERCENT=10
# Optional: separate secret for refresh tokens (recommended for production)
# JWT_REFRESH_SECRET=

# Security Settings
MAX_LOGIN_ATTEMPTS=10
LOGIN_TIMEOUT=5
BCRYPT_ROUNDS=10

# Team Configuration
MAX_TEAM_MEMBERS=4

# Flag Submission
FLAG_MAX_LENGTH=200

# Real-time / SSE Configuration
SSE_HEARTBEAT_INTERVAL=30s

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# File Upload Configuration
MAX_FILE_SIZE=20971520
FILE_UPLOAD_MAX_SIZE=20971520
MAX_FILES_PER_CHALLENGE=10
UPLOAD_DIR=uploads/challenges

# SMTP Configuration (for OTP/verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=

# Admin platform-reset secret -- required; reset endpoints fail closed
# if unset. Generate a long random string, don't reuse it elsewhere.
RESET_SECRET_CODE=
