# Copy this file to .env and adjust as needed for local development.
# Never commit .env -- it's gitignored, keep it that way.
#
# Currently the app has no required environment variables (the API
# client uses a relative base URL by design). VITE_API_URL is an
# opt-in override, not yet read by any code -- see .env for details.

# VITE_API_URL=http://localhost:10000
